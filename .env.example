# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real passwords.
POSTGRES_USER=your_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Metabase (Phase 7)
METABASE_RO_PASSWORD=change_me
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me

# Data lake (Phase 8). Local: RustFS (S3-compatible). AWS: remove S3_ENDPOINT_URL, use real keys.
# Leave LANDING_URI unset to keep the landing zone on local disk (data/landing).
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
S3_ENDPOINT_URL=http://localhost:9000
LANDING_URI=s3://ecommerce-lake/landing
